---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
// Sort by pubDate descending
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Lead hero post
const heroPost = sortedPosts.find(p => p.slug === 'servicetitan-2026-audit') || sortedPosts[0];

// Matrix platform posts: ServiceTitan, Jobber, Housecall Pro, Simpro
const matrixSlugs = ['servicetitan-2026-audit', 'jobber-2026-deep-dive', 'housecall-pro-2026-review', 'simpro-commercial-mep-audit'];
const matrixPosts = matrixSlugs
  .map(slug => sortedPosts.find(p => p.slug === slug))
  .filter((p): p is NonNullable<typeof p> => p !== undefined);

// Top 3 for Lab Consensus Verdict
const topVerdictPosts = sortedPosts.filter(p => p.data.score >= 9.0).slice(0, 3);
---

<BaseLayout title="TradeTechHQ | 2026 B2B Software Journalism & Investigative Reviews">
  <div class="flex flex-col w-full">
    <!-- Top Investigative Lead & Hero Section -->
    <section class="w-full max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop pt-space-xl pb-space-3xl">
      <!-- Localized & Compliance Indicator Pill -->
      <div class="flex flex-wrap items-center justify-between gap-space-sm pb-space-lg">
        <div class="inline-flex items-center gap-space-xs bg-surface-container-low text-on-surface px-space-sm py-space-2xs rounded-full border border-outline-variant/30">
          <span class="w-2 h-2 rounded-full bg-secondary"></span>
          <span class="font-label-caps text-label-caps uppercase tracking-wider text-on-surface-variant">Global Contractor Edition: US • UK • CA • AU</span>
          <span class="font-label-data text-label-data text-outline">|</span>
          <span class="font-label-data text-label-data text-on-surface-variant font-medium">Currency &amp; Tax Compliance Active</span>
        </div>
        <div class="inline-flex items-center gap-space-xs font-label-caps text-label-caps text-on-surface-variant">
          <span class="material-symbols-outlined text-[15px] text-secondary">verified</span>
          <span>AUDITED ACROSS 48 ENTERPRISE DEPLOYMENTS</span>
        </div>
      </div>

      <!-- Editorial Lead Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl lg:gap-space-2xl items-start">
        <!-- Left Column: Story Core (7 Cols) -->
        <div class="lg:col-span-7 flex flex-col gap-space-md">
          <div class="inline-flex items-center gap-space-xs">
            <span class="font-label-caps text-label-caps px-space-xs py-space-3xs rounded bg-primary-container text-on-primary font-semibold tracking-widest uppercase">
              Investigative Report
            </span>
            <span class="font-label-caps text-label-caps text-outline tracking-wider uppercase">
              {heroPost.data.category} • 2026 Audit
            </span>
          </div>

          <h1 class="font-headline-xl text-headline-xl lg:text-display-hero text-on-surface tracking-tight font-normal leading-tight">
            <a href={`/blog/${heroPost.slug}`} class="hover:text-secondary transition-colors">
              {heroPost.data.title}
            </a>
          </h1>

          <p class="font-body-lead text-body-lead text-on-surface-variant leading-relaxed">
            {heroPost.data.summary}
          </p>

          <!-- Author & Metadata Block -->
          <div class="flex flex-wrap items-center gap-y-space-xs gap-x-space-md pt-space-xs pb-space-sm font-label-data text-label-data text-on-surface-variant">
            <div class="flex items-center gap-space-xs">
              <span class="w-6 h-6 rounded-full bg-surface-container-highest flex items-center justify-center font-semibold text-caption text-on-surface">AV</span>
              <span class="text-on-surface font-medium">{heroPost.data.author}</span>
              <span class="text-outline text-caption">(Lead Systems Architect)</span>
            </div>
            <span class="text-outline-variant">•</span>
            <div class="flex items-center gap-space-3xs">
              <span class="material-symbols-outlined text-[14px] text-secondary">verified_user</span>
              <span>Fact-Checked by Technical Advisory Board</span>
            </div>
            <span class="text-outline-variant">•</span>
            <span>March 2026</span>
            <span class="text-outline-variant">•</span>
            <span>{heroPost.data.readTime}</span>
          </div>

          <!-- Action CTAs -->
          <div class="flex flex-wrap items-center gap-space-sm pt-space-xs">
            <a class="inline-flex items-center justify-center gap-space-xs px-space-lg py-space-sm rounded bg-primary text-on-primary hover:bg-inverse-surface transition-all font-label-data text-label-data shadow-sm" href={`/blog/${heroPost.slug}`}>
              <span>Read Full Investigation</span>
              <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
            </a>
            <a class="inline-flex items-center justify-center gap-space-xs px-space-lg py-space-sm rounded bg-surface-container-low text-on-surface hover:bg-surface-container transition-all font-label-data text-label-data border border-outline-variant/40" href="#matrix-section">
              <span class="material-symbols-outlined text-[16px]">table_chart</span>
              <span>Explore Benchmark Matrix</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Apple-inspired Metric Scorecard Card (5 Cols) -->
        <div class="lg:col-span-5 flex flex-col gap-space-md">
          <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm border border-outline-variant/30 flex flex-col gap-space-md relative overflow-hidden">
            <div class="absolute top-0 right-0 w-32 h-32 bg-secondary/5 rounded-full blur-2xl pointer-events-none"></div>
            <div class="flex items-center justify-between">
              <span class="font-label-caps text-label-caps uppercase tracking-wider text-outline">Lab Consensus Verdict</span>
              <span class="font-label-data text-label-data text-secondary font-medium">Updated March 2026</span>
            </div>

            <!-- Dynamic Verdict Posts -->
            {topVerdictPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="bg-surface-container-low rounded-lg p-space-md flex items-center justify-between group hover:bg-surface-container transition-colors border border-outline-variant/20">
                <div class="flex flex-col gap-space-3xs">
                  <span class="font-label-caps text-label-caps text-secondary font-semibold">{post.data.badge || 'VERIFIED BENCHMARK'}</span>
                  <span class="font-headline-sm text-headline-sm text-on-surface group-hover:text-secondary transition-colors">
                    {post.slug === 'servicetitan-2026-audit' ? 'ServiceTitan' : post.slug === 'jobber-2026-deep-dive' ? 'Jobber' : 'Housecall Pro'}
                  </span>
                  <span class="font-caption text-caption text-on-surface-variant">{post.data.recommendedFor}</span>
                </div>
                <div class="text-right flex flex-col items-end">
                  <span class="font-headline-md text-headline-md font-semibold text-on-surface">
                    {post.data.score.toFixed(1)}<span class="text-label-data font-normal text-outline">/10</span>
                  </span>
                  <div class="flex text-amber-500 text-[13px]">★★★★★</div>
                </div>
              </a>
            ))}

            <!-- Forensic Diagnostic Data Preview -->
            <div class="pt-space-xs flex items-center justify-between font-label-data text-label-data text-on-surface-variant border-t border-outline-variant/20">
              <div class="flex items-center gap-space-2xs">
                <span class="material-symbols-outlined text-[16px] text-on-surface">sync_alt</span>
                <span>API Sync Latency: &lt;1.8s</span>
              </div>
              <div class="flex items-center gap-space-2xs">
                <span class="material-symbols-outlined text-[16px] text-on-surface">offline_pin</span>
                <span>Offline Cache: 100% Verified</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Editorial Transparency & Forensic Methodology Strip -->
    <section class="w-full bg-surface-container-lowest border-y border-outline-variant/30 py-space-md">
      <div class="max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-space-md items-center font-label-data text-label-data">
          <div class="flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-[20px] text-secondary">science</span>
            <div class="flex flex-col">
              <span class="text-on-surface font-medium">100% Autonomous Lab</span>
              <span class="font-caption text-caption text-on-surface-variant">Commercial test deployments</span>
            </div>
          </div>

          <div class="flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-[20px] text-secondary">security</span>
            <div class="flex flex-col">
              <span class="text-on-surface font-medium">Zero Paid Placement</span>
              <span class="font-caption text-caption text-on-surface-variant">Strict editorial firewall</span>
            </div>
          </div>

          <div class="flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-[20px] text-secondary">checklist_rtl</span>
            <div class="flex flex-col">
              <span class="text-on-surface font-medium">54-Point Audit Rubric</span>
              <span class="font-caption text-caption text-on-surface-variant">Reproducible benchmarks</span>
            </div>
          </div>

          <div class="flex items-center justify-start md:justify-end">
            <a class="inline-flex items-center gap-space-3xs text-secondary hover:text-secondary-container font-label-data text-label-data font-medium" href="#methodology">
              <span>Explore Audit Protocol</span>
              <span class="material-symbols-outlined text-[16px]">arrow_right_alt</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Software Comparison Table: The 2026 Trade Contractor Benchmark Matrix -->
    <section class="w-full max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop py-space-3xl" id="matrix-section">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pb-space-xl">
        <div class="max-w-2xl flex flex-col gap-space-2xs">
          <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider">Independent Testing Telemetry</span>
          <h2 class="font-headline-lg text-headline-lg text-on-surface">The 2026 Trade Contractor Benchmark Matrix</h2>
          <p class="font-body-md text-body-md text-on-surface-variant">
            Forensic comparative analysis of market-leading platforms. Data points are audited via actual live technician telemetry, API throttling tests, and blinded customer satisfaction surveys.
          </p>
        </div>

        <!-- Quick Interactive Filter Pills -->
        <div class="inline-flex p-space-3xs bg-surface-container-low rounded-lg self-start md:self-auto font-label-caps text-label-caps border border-outline-variant/30">
          <button class="px-space-sm py-space-2xs bg-primary text-on-primary rounded font-semibold transition-colors" type="button">Enterprise (20+)</button>
          <button class="px-space-sm py-space-2xs text-on-surface-variant hover:text-on-surface rounded transition-colors" type="button">Mid-Market (5-19)</button>
          <button class="px-space-sm py-space-2xs text-on-surface-variant hover:text-on-surface rounded transition-colors" type="button">Solo &amp; Startup (1-4)</button>
        </div>
      </div>

      <!-- Minimalist Comparison Matrix Table -->
      <div class="w-full overflow-x-auto bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30">
        <table class="w-full text-left font-body-md text-body-md min-w-[900px]">
          <thead>
            <tr class="bg-surface-container-low font-label-caps text-label-caps text-outline uppercase tracking-wider border-b border-outline-variant/30">
              <th class="py-space-md px-space-lg w-1/4 sticky left-0 z-20 bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)] font-label-caps text-label-caps text-outline uppercase tracking-wider">
                Platform &amp; Rating
              </th>
              <th class="py-space-md px-space-md w-1/4">Core Architecture</th>
              <th class="py-space-md px-space-md w-1/4">Forensic Pros &amp; Cons</th>
              <th class="py-space-md px-space-md w-1/6">Real Cost Profile</th>
            </tr>
          </thead>
          <tbody class="text-on-surface divide-y divide-outline-variant/20">
            {matrixPosts.map((item) => {
              const platformName = item.slug === 'servicetitan-2026-audit' ? 'ServiceTitan'
                : item.slug === 'jobber-2026-deep-dive' ? 'Jobber'
                : item.slug === 'housecall-pro-2026-review' ? 'Housecall Pro'
                : 'Simpro';
              return (
                <tr class="hover:bg-surface-container-low/50 transition-colors">
                  {/* FIRST COLUMN: Platform & Rating WITH CTAS LOCATED DIRECTLY UNDERNEATH */}
                  <td class="py-space-lg px-space-lg align-top sticky left-0 z-20 bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
                    <div class="flex flex-col gap-space-xs">
                      <div class="flex items-center gap-space-xs">
                        <span class={`w-8 h-8 rounded flex items-center justify-center font-bold text-[14px] ${item.data.platformCode === 'ST' ? 'bg-primary-container text-on-primary' : item.data.platformCode === 'JB' ? 'bg-secondary text-on-secondary' : item.data.platformCode === 'HP' ? 'bg-primary text-on-primary' : 'bg-surface-container-highest text-on-surface'}`}>
                          {item.data.platformCode || 'TT'}
                        </span>
                        <div class="flex flex-col">
                          <span class="font-headline-sm text-headline-sm text-on-surface leading-tight">{platformName}</span>
                          <span class={`font-label-caps text-label-caps font-semibold ${item.data.badge?.includes('WINNER') ? 'text-secondary' : 'text-outline'}`}>
                            {item.data.badge || 'VERIFIED AUDIT'}
                          </span>
                        </div>
                      </div>

                      <div class="flex items-center gap-space-2xs pt-space-3xs">
                        <span class="font-headline-md text-headline-md font-semibold text-on-surface">
                          {item.data.score.toFixed(1)}<span class="text-label-data font-normal text-outline">/10</span>
                        </span>
                        <div class="flex text-amber-500 text-[12px]">
                          {item.data.score >= 9.5 ? '★★★★★' : '★★★★'}<span class={item.data.score < 9.5 ? 'text-outline-variant' : ''}>{item.data.score < 9.5 ? '★' : ''}</span>
                        </div>
                        <span class="font-caption text-caption text-on-surface-variant">({item.data.auditsCount} audits)</span>
                      </div>

                      <span class="font-caption text-caption text-on-surface-variant">{item.data.recommendedFor}</span>

                      {/* CTA BUTTONS LOCATED IN FIRST COLUMN DIRECTLY BELOW RATING */}
                      <div class="flex flex-col items-stretch gap-space-2xs pt-space-xs">
                        <a class="w-full px-space-md py-space-2xs rounded bg-primary text-on-primary hover:bg-inverse-surface transition-colors font-label-data text-label-data text-center inline-block shadow-sm" href={`/blog/${item.slug}`}>
                          Read Audit
                        </a>
                        <a class="w-full px-space-md py-space-3xs rounded bg-surface-container-low hover:bg-surface-container text-secondary transition-colors font-label-caps text-label-caps flex items-center justify-center gap-space-3xs border border-outline-variant/30" href={item.data.vendorUrl} target="_blank" rel="noopener noreferrer">
                          <span>Visit Official Site</span>
                          <span class="material-symbols-outlined text-[14px]">open_in_new</span>
                        </a>
                      </div>
                    </div>
                  </td>

                  {/* Core Architecture Column */}
                  <td class="py-space-lg px-space-md align-top">
                    <div class="flex flex-col gap-space-xs text-body-sm font-body-sm">
                      {item.data.features && item.data.features.map((feat) => (
                        <div class="flex items-center gap-space-2xs text-on-surface">
                          <span class="material-symbols-outlined text-[15px] text-secondary">check_circle</span>
                          <span>{feat}</span>
                        </div>
                      ))}
                    </div>
                  </td>

                  {/* Forensic Pros & Cons Column */}
                  <td class="py-space-lg px-space-md align-top">
                    <div class="flex flex-col gap-space-xs text-body-sm font-body-sm">
                      {item.data.pros.slice(0, 2).map((pro) => (
                        <div class="flex items-start gap-space-2xs text-on-surface">
                          <span class="text-secondary font-bold leading-none">+</span>
                          <span>{pro}</span>
                        </div>
                      ))}
                      {item.data.cons.slice(0, 2).map((con) => (
                        <div class="flex items-start gap-space-2xs text-on-surface-variant">
                          <span class="text-outline font-bold leading-none">-</span>
                          <span>{con}</span>
                        </div>
                      ))}
                    </div>
                  </td>

                  {/* Real Cost Profile Column */}
                  <td class="py-space-lg px-space-md align-top">
                    <div class="flex flex-col gap-space-3xs">
                      <span class="font-label-data text-label-data font-semibold text-on-surface">{item.data.pricing || 'Custom Quote'}</span>
                      <span class="font-caption text-caption text-on-surface-variant">{item.data.pricingSub || 'Billed Annually'}</span>
                      <span class="font-label-caps text-label-caps text-outline pt-space-2xs">{item.data.pricingTier || 'Standard Tier'}</span>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <!-- Telemetry Diagnostic Sub-Panel -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md pt-space-lg">
        <div class="bg-surface-container-low rounded-lg p-space-md flex flex-col gap-space-2xs border border-outline-variant/30">
          <span class="font-label-caps text-label-caps text-outline uppercase">QuickBooks &amp; Xero Two-Way Sync</span>
          <span class="font-headline-sm text-headline-sm text-on-surface">Sub-2.4s Average Latency</span>
          <p class="font-caption text-caption text-on-surface-variant">Stress-tested with 10,000 synthetic invoices and payments pushed under simulated 4G mobile field connection.</p>
        </div>

        <div class="bg-surface-container-low rounded-lg p-space-md flex flex-col gap-space-2xs border border-outline-variant/30">
          <span class="font-label-caps text-label-caps text-outline uppercase">Zero-Connectivity Offline Storage</span>
          <span class="font-headline-sm text-headline-sm text-on-surface">100% Cache Reliability</span>
          <p class="font-caption text-caption text-on-surface-variant">Evaluated in concrete basements and subterranean facilities without cell service. Zero lost job tickets recorded.</p>
        </div>

        <div class="bg-surface-container-low rounded-lg p-space-md flex flex-col gap-space-2xs border border-outline-variant/30">
          <span class="font-label-caps text-label-caps text-outline uppercase">Contractor Sentiment Index</span>
          <span class="font-headline-sm text-headline-sm text-on-surface">94.8% Field Confidence</span>
          <p class="font-caption text-caption text-on-surface-variant">Aggregated from 1,280 verified technician interviews conducted post 90-day deployment phases across Q1 2026.</p>
        </div>
      </div>
    </section>

    <!-- In-Depth Review Cards Grid: Latest Lab Reviews & Field Audits -->
    <section class="w-full bg-surface-container-low py-space-3xl border-t border-outline-variant/30">
      <div class="max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop">
        <!-- Grid Header & Vertical Tabs -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md pb-space-xl">
          <div class="flex flex-col gap-space-2xs">
            <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider">Independent Investigations</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">Latest Lab Reviews &amp; Field Audits</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">Deep technical forensics, software teardowns, and architecture evaluations for trade leaders.</p>
          </div>

          <div class="flex flex-wrap gap-space-2xs font-label-data text-label-data">
            <button class="px-space-sm py-space-xs rounded bg-primary text-on-primary font-medium" type="button">All Verticals</button>
            <button class="px-space-sm py-space-xs rounded bg-surface-container-lowest text-on-surface hover:bg-surface-container-highest transition-colors font-medium border border-outline-variant/30" type="button">HVAC &amp; Mechanical</button>
            <button class="px-space-sm py-space-xs rounded bg-surface-container-lowest text-on-surface hover:bg-surface-container-highest transition-colors font-medium border border-outline-variant/30" type="button">Plumbing</button>
            <button class="px-space-sm py-space-xs rounded bg-surface-container-lowest text-on-surface hover:bg-surface-container-highest transition-colors font-medium border border-outline-variant/30" type="button">Electrical</button>
            <button class="px-space-sm py-space-xs rounded bg-surface-container-lowest text-on-surface hover:bg-surface-container-highest transition-colors font-medium border border-outline-variant/30" type="button">Locksmith</button>
            <button class="px-space-sm py-space-xs rounded bg-surface-container-lowest text-on-surface hover:bg-surface-container-highest transition-colors font-medium border border-outline-variant/30" type="button">Commercial MEP</button>
          </div>
        </div>

        <!-- Dynamic Review Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg">
          {sortedPosts.slice(0, 6).map((post) => (
            <article class="bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm border border-outline-variant/30 flex flex-col group hover:shadow-md transition-shadow">
              <a href={`/blog/${post.slug}`} class="block h-48 w-full bg-cover bg-center overflow-hidden relative" style={post.data.featuredImage ? `background-image: url('${post.data.featuredImage}')` : 'background-color: #ebedfb;'}>
                <div class="absolute inset-0 bg-primary/10 group-hover:bg-transparent transition-colors"></div>
              </a>

              <div class="p-space-lg flex flex-col flex-1 justify-between gap-space-md">
                <div class="flex flex-col gap-space-xs">
                  <div class="flex items-center justify-between">
                    <span class="font-label-caps text-label-caps text-secondary font-semibold uppercase">{post.data.category}</span>
                    <div class="flex items-center gap-space-3xs text-label-data font-semibold text-on-surface">
                      <span>★</span>
                      <span>{post.data.score.toFixed(1)}</span>
                    </div>
                  </div>

                  <h3 class="font-headline-md text-headline-md text-on-surface group-hover:text-secondary transition-colors leading-snug">
                    <a href={`/blog/${post.slug}`}>
                      {post.data.title}
                    </a>
                  </h3>

                  <p class="font-body-md text-body-md text-on-surface-variant line-clamp-2">
                    {post.data.summary}
                  </p>
                </div>

                <div class="flex items-center justify-between pt-space-xs font-label-data text-label-data text-outline border-t border-outline-variant/20">
                  <span>Audited by {post.data.author}</span>
                  <a href={`/blog/${post.slug}`} class="text-secondary font-medium group-hover:translate-x-0.5 transition-transform flex items-center gap-space-3xs">
                    <span>Read Audit</span>
                    <span>→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
