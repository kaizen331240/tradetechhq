---
import BaseLayout from '../layouts/BaseLayout.astro';

const rubricDomains = [
  {
    number: "01",
    title: "Dispatch & Routing Optimization Telemetry",
    weight: "25% Overall Weight",
    icon: "alt_route",
    metrics: [
      "Algorithmic re-route calculation latency under fleet scale (10, 25, 45, 100 trucks)",
      "Dynamic drive-time recalibration based on live municipal transit matrices",
      "Proactive schedule breach warnings (18-22 min advance alerts)",
      "Fuel efficiency clustering preservation under randomized cancellations"
    ]
  },
  {
    number: "02",
    title: "Accounting & General Ledger Integrity",
    weight: "25% Overall Weight",
    icon: "account_balance",
    metrics: [
      "Sub-2s REST API sync latency with Sage Intacct, NetSuite, and QuickBooks Online",
      "Item master parity and multi-entity consolidated tax rounding conformity",
      "Batch Web Connector stability for QuickBooks Desktop Enterprise",
      "Automated ledger audit trail depth and conflict resolution"
    ]
  },
  {
    number: "03",
    title: "Mobile Field Execution & Offline Cache",
    weight: "25% Overall Weight",
    icon: "offline_pin",
    metrics: [
      "Faraday cage zero-connectivity service lifecycle completion",
      "SQLite local buffer preservation in concrete basements without cell signal",
      "Sub-2,000ms timestamp synchronization with zero invoice race collisions",
      "Technician UI cognitive load, tap density, and invoice completion friction"
    ]
  },
  {
    number: "04",
    title: "Procurement Economics & True TCO",
    weight: "25% Overall Weight",
    icon: "payments",
    metrics: [
      "Transparent breakdown of mandatory onboarding ramp fees ($4,500 - $18,000+)",
      "Per-technician monthly seat licensing vs. add-on module bill creep",
      "Payment gateway interchange margin audits (embedded fees vs. direct merchant)",
      "Amortized ROI payback modeling based on fleet scale (5-to-15 vs. 25+ trucks)"
    ]
  }
];

const teamMembers = [
  {
    name: "Marcus Vance",
    role: "Lead Systems Architect & Co-Founder",
    credentials: "Former VP of Systems Architecture for 450-truck regional mechanical contractor. 16+ years in ERP/dispatch deployments.",
    badge: "Certified Review Architect",
    icon: "engineering"
  },
  {
    name: "Elena Rostova",
    role: "Senior Enterprise Systems Auditor",
    credentials: "Specialist in bidirectional ERP synchronization, database replication, and general ledger audit integrity.",
    badge: "ERP Systems Specialist",
    icon: "memory"
  },
  {
    name: "Alexander Vance",
    role: "Lead Systems Architect & Diagnostic Engineer",
    credentials: "Deep expertise in predictive fleet telematics, geofenced dispatch routing, and dynamic pricing algorithms.",
    badge: "Fleet Telemetry Lead",
    icon: "radar"
  },
  {
    name: "Robert Stirling",
    role: "Senior Commercial Contracting Analyst",
    credentials: "20+ years evaluating commercial MEP estimating, AIA billing compliance, and multi-depot inventory hierarchies.",
    badge: "Commercial MEP Specialist",
    icon: "domain"
  }
];
---

<BaseLayout 
  title="Editorial Integrity & Testing Methodology | TradeTechHQ"
  description="How TradeTechHQ conducts autonomous laboratory testing, API stress tests, and contractor peer reviews with zero vendor compensation or sponsored rankings."
>
  <div class="flex flex-col w-full">
    <!-- Top Global Status & Breadcrumbs -->
    <section class="w-full bg-surface-container-low/70 py-space-sm border-b border-outline-variant/30">
      <div class="max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop flex flex-wrap items-center justify-between gap-y-space-xs text-on-surface-variant">
        <nav aria-label="Breadcrumb" class="flex items-center gap-space-2xs font-label-data text-label-data">
          <a class="text-on-surface-variant hover:text-on-surface transition-colors" href="/">Home</a>
          <span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
          <span class="text-on-surface font-semibold">Methodology &amp; About</span>
        </nav>

        <div class="flex flex-wrap items-center gap-space-xs font-label-caps text-label-caps">
          <span class="inline-flex items-center gap-space-2xs px-space-xs py-space-3xs rounded-full bg-surface-container-lowest shadow-sm text-on-surface border border-outline-variant/30">
            <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
            Independent Lab Protocol v2026.4
          </span>
          <span class="hidden md:inline-flex items-center gap-space-2xs px-space-xs py-space-3xs rounded-full bg-surface-container-high/60 text-on-surface-variant">
            <span class="material-symbols-outlined text-[13px] text-secondary">verified</span>
            Strict Institutional Firewall
          </span>
        </div>
      </div>
    </section>

    <!-- Editorial Hero Section -->
    <section class="w-full max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop pt-space-xl pb-space-3xl">
      <div class="flex flex-col gap-space-md max-w-3xl">
        <div class="inline-flex items-center gap-space-xs">
          <span class="font-label-caps text-label-caps px-space-xs py-space-3xs rounded bg-primary text-on-primary font-semibold tracking-widest uppercase">
            Institutional Standard
          </span>
          <span class="font-label-caps text-label-caps text-outline tracking-wider uppercase">
            Forensic Testing Rubric
          </span>
        </div>

        <h1 class="font-headline-xl text-headline-xl lg:text-display-hero text-on-surface tracking-tight font-normal leading-tight">
          Editorial Integrity &amp; Testing Methodology for B2B Contractors
        </h1>

        <p class="font-body-lead text-body-lead text-on-surface-variant leading-relaxed">
          TradeTechHQ was founded to eliminate pay-to-play review spam, affiliate bias, and sponsored rankings in the commercial trade technology sector. We operate the industry's only autonomous software laboratory dedicated to stress-testing field dispatch, ERP sync latency, and technician adoption curves under strict blind conditions.
        </p>

        <!-- Quick Anchor Navigation -->
        <div class="flex flex-wrap gap-space-xs pt-space-xs font-label-data text-label-data">
          <a href="#lab-vs-directories" class="px-space-md py-space-2xs rounded bg-surface-container-low hover:bg-surface-container text-on-surface transition-colors border border-outline-variant/30">
            Lab vs. Directories
          </a>
          <a href="#rubric" class="px-space-md py-space-2xs rounded bg-surface-container-low hover:bg-surface-container text-on-surface transition-colors border border-outline-variant/30">
            54-Point Rubric
          </a>
          <a href="#advisory-board" class="px-space-md py-space-2xs rounded bg-surface-container-low hover:bg-surface-container text-on-surface transition-colors border border-outline-variant/30">
            Contractor Peer Review
          </a>
          <a href="#ftc" class="px-space-md py-space-2xs rounded bg-surface-container-low hover:bg-surface-container text-on-surface transition-colors border border-outline-variant/30">
            FTC Compliance
          </a>
        </div>
      </div>
    </section>

    <!-- Section 1: The Problem with Traditional B2B Review Sites -->
    <section class="w-full bg-surface-container-lowest border-y border-outline-variant/30 py-space-3xl" id="lab-vs-directories">
      <div class="max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop flex flex-col gap-space-2xl">
        <div class="flex flex-col gap-space-2xs max-w-2xl">
          <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider font-semibold">The Industry Dilemma</span>
          <h2 class="font-headline-lg text-headline-lg text-on-surface">Why Traditional Software Review Sites Fail Trade Contractors</h2>
          <p class="font-body-md text-body-md text-on-surface-variant">
            When a contracting company with 30 trucks selects the wrong field management system, the cost is not merely a forfeited software subscription—it is months of lost technician billable hours, customer friction, and painful data migration.
          </p>
        </div>

        <!-- Comparative Breakdown Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-space-xl">
          <!-- Standard Pay-To-Play Model -->
          <div class="bg-surface-container-low rounded-xl p-space-xl border border-outline-variant/30 flex flex-col gap-space-md">
            <div class="flex items-center justify-between border-b border-outline-variant/30 pb-space-xs">
              <h3 class="font-headline-sm text-headline-sm text-on-surface">Traditional B2B Software Directories</h3>
              <span class="font-label-caps text-label-caps px-space-xs py-space-3xs rounded bg-error/10 text-error font-semibold">
                PAY-TO-PLAY MODEL
              </span>
            </div>
            <ul class="space-y-space-sm font-body-sm text-body-sm text-on-surface-variant">
              <li class="flex items-start gap-space-xs">
                <span class="text-error font-bold text-[16px] leading-none mt-0.5">✕</span>
                <span><strong>Sponsored Sort Orders:</strong> The vendors that pay the highest cost-per-click (CPC) or affiliate bounty occupy the top grid positions.</span>
              </li>
              <li class="flex items-start gap-space-xs">
                <span class="text-error font-bold text-[16px] leading-none mt-0.5">✕</span>
                <span><strong>No Real Software Access:</strong> Reviews are aggregated from unverified consumer feedback forms or marketing PR sheets with zero code testing.</span>
              </li>
              <li class="flex items-start gap-space-xs">
                <span class="text-error font-bold text-[16px] leading-none mt-0.5">✕</span>
                <span><strong>Hidden Vendor Pre-Approvals:</strong> Negative performance findings are routinely negotiated away in exchange for annual vendor directory retainers.</span>
              </li>
              <li class="flex items-start gap-space-xs">
                <span class="text-error font-bold text-[16px] leading-none mt-0.5">✕</span>
                <span><strong>Superficial Checklist Scoring:</strong> Software is evaluated on bullet-point marketing claims rather than real-world API latency or offline reliability.</span>
              </li>
            </ul>
          </div>

          <!-- TradeTechHQ Autonomous Lab Model -->
          <div class="bg-primary text-on-primary rounded-xl p-space-xl shadow-lg relative overflow-hidden flex flex-col gap-space-md">
            <div class="absolute -top-16 -right-16 w-64 h-64 bg-secondary/20 rounded-full blur-2xl pointer-events-none"></div>
            <div class="flex items-center justify-between border-b border-white/10 pb-space-xs">
              <h3 class="font-headline-sm text-headline-sm text-on-primary">TradeTechHQ Autonomous Laboratory</h3>
              <span class="font-label-caps text-label-caps px-space-xs py-space-3xs rounded bg-secondary text-on-secondary font-semibold">
                SCIENTIFIC AUDIT
              </span>
            </div>
            <ul class="space-y-space-sm font-body-sm text-body-sm text-on-primary-container">
              <li class="flex items-start gap-space-xs">
                <span class="text-secondary-fixed font-bold text-[16px] leading-none mt-0.5">✓</span>
                <span><strong>Anonymous License Procurement:</strong> We purchase production subscriptions directly using our own lab budget. No vendor knows they are being tested.</span>
              </li>
              <li class="flex items-start gap-space-xs">
                <span class="text-secondary-fixed font-bold text-[16px] leading-none mt-0.5">✓</span>
                <span><strong>Live 45-Truck Fleet Sandbox:</strong> We simulate real intraday dispatch disruption, emergency call injections, and road transit recalculations.</span>
              </li>
              <li class="flex items-start gap-space-xs">
                <span class="text-secondary-fixed font-bold text-[16px] leading-none mt-0.5">✓</span>
                <span><strong>Faraday Cage Zero-Connectivity Stress Tests:</strong> We physically simulate concrete mechanical vaults to prove offline SQLite reliability.</span>
              </li>
              <li class="flex items-start gap-space-xs">
                <span class="text-secondary-fixed font-bold text-[16px] leading-none mt-0.5">✓</span>
                <span><strong>Strict Editorial Firewall:</strong> No vendor can buy placement, alter scores, preview verdicts, or censor critical implementation friction.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: The 54-Point Technical Audit Rubric -->
    <section class="w-full max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop py-space-3xl" id="rubric">
      <div class="flex flex-col gap-space-2xs max-w-2xl pb-space-xl">
        <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider font-semibold">Evaluation Rubric</span>
        <h2 class="font-headline-lg text-headline-lg text-on-surface">The 54-Point Technical Audit Rubric</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">
          Every software platform evaluated by TradeTechHQ is graded across four equally weighted core dimensions, comprising 54 objective criteria verified in our testing topologies.
        </p>
      </div>

      <!-- 4 Rubric Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg">
        {rubricDomains.map((domain) => (
          <div class="bg-surface-container-lowest rounded-xl p-space-lg shadow-sm border border-outline-variant/30 flex flex-col justify-between gap-space-md">
            <div class="flex flex-col gap-space-xs">
              <div class="flex items-center justify-between border-b border-outline-variant/20 pb-space-xs">
                <div class="flex items-center gap-space-xs">
                  <span class="w-8 h-8 rounded bg-primary-container text-on-primary flex items-center justify-center font-bold text-label-data">
                    {domain.number}
                  </span>
                  <span class="font-headline-sm text-headline-sm text-on-surface">{domain.title}</span>
                </div>
                <span class="font-label-caps text-label-caps text-secondary font-semibold">{domain.weight}</span>
              </div>

              <ul class="space-y-space-xs font-body-sm text-body-sm text-on-surface-variant pt-space-xs">
                {domain.metrics.map((metric) => (
                  <li class="flex items-start gap-space-2xs">
                    <span class="material-symbols-outlined text-[16px] text-secondary mt-0.5 flex-shrink-0">check_circle</span>
                    <span>{metric}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="pt-space-xs border-t border-outline-variant/20 flex items-center justify-between font-label-data text-label-data text-outline">
              <span>Audited via Live Telemetry</span>
              <span class="material-symbols-outlined text-[18px] text-secondary">{domain.icon}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3: Contractor Peer Review Board -->
    <section class="w-full bg-surface-container-low py-space-3xl border-t border-outline-variant/30" id="advisory-board">
      <div class="max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop flex flex-col gap-space-xl">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md">
          <div class="flex flex-col gap-space-2xs max-w-2xl">
            <span class="font-label-caps text-label-caps text-secondary uppercase tracking-wider font-semibold">Human Verification Layer</span>
            <h2 class="font-headline-lg text-headline-lg text-on-surface">The 24-Contractor Peer Review Board</h2>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Synthetic laboratory benchmarks are necessary, but field reality is definitive. Every software audit is cross-examined by active trade owners and dispatch directors operating across residential and commercial verticals.
            </p>
          </div>

          <div class="inline-flex items-center gap-space-xs px-space-md py-space-xs rounded bg-surface-container-lowest text-on-surface font-label-data text-label-data border border-outline-variant/30">
            <span class="material-symbols-outlined text-[18px] text-secondary">groups</span>
            <span>24 Active Advisory Members</span>
          </div>
        </div>

        <!-- 4 Team Leadership Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-md">
          {teamMembers.map((member) => (
            <div class="bg-surface-container-lowest rounded-xl p-space-md shadow-sm border border-outline-variant/30 flex flex-col justify-between gap-space-md">
              <div class="flex flex-col gap-space-xs">
                <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center text-secondary border border-outline-variant/30">
                  <span class="material-symbols-outlined text-[24px]">{member.icon}</span>
                </div>
                <h3 class="font-headline-sm text-headline-sm text-on-surface">{member.name}</h3>
                <span class="font-label-caps text-label-caps text-secondary font-semibold">{member.role}</span>
                <p class="font-caption text-caption text-on-surface-variant leading-relaxed pt-space-3xs">
                  {member.credentials}
                </p>
              </div>

              <div class="pt-space-xs border-t border-outline-variant/20 flex items-center gap-space-3xs font-label-caps text-[10px] text-outline">
                <span class="material-symbols-outlined text-[14px] text-secondary">verified</span>
                <span>{member.badge}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Section 4: FTC Compliance & Partner Link Transparency -->
    <section class="w-full max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop py-space-3xl" id="ftc">
      <div class="bg-surface-container-lowest rounded-xl p-space-xl shadow-sm border border-outline-variant/30 flex flex-col gap-space-md">
        <div class="flex items-center gap-space-xs text-secondary font-label-caps text-label-caps font-semibold">
          <span class="material-symbols-outlined text-[20px]">shield</span>
          <span>FTC COMPLIANCE &amp; AFFILIATE FIREWALL CHARTER</span>
        </div>

        <h2 class="font-headline-lg text-headline-lg text-on-surface">Full Commercial Transparency Disclosure</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-space-lg font-body-md text-body-md text-on-surface-variant">
          <div class="flex flex-col gap-space-xs">
            <h3 class="font-headline-sm text-headline-sm text-on-surface">How We Fund Our Independent Labs</h3>
            <p>
              TradeTechHQ produces extensive, code-level evaluations that require thousands of dollars in commercial software subscriptions, cloud sandbox hosting, and technical testing hours.
            </p>
            <p>
              To maintain our autonomous lab without charging paywalls to trade contractors, some outbound links to vendor websites are tracked affiliate partner links. If an enterprise purchases a subscription after clicking our link, TradeTechHQ may receive a commission at zero additional cost to the contractor.
            </p>
          </div>

          <div class="flex flex-col gap-space-xs">
            <h3 class="font-headline-sm text-headline-sm text-on-surface">The Strict Editorial Firewall</h3>
            <p>
              Under our founding charter, commercial affiliate partnerships are strictly separated from editorial benchmarking. Our research team has zero visibility into affiliate agreements, and marketing partners cannot:
            </p>
            <ul class="space-y-space-3xs font-body-sm text-body-sm text-on-surface list-disc pl-5">
              <li>Purchase or bid for higher positions in our benchmark matrices.</li>
              <li>Preview lab verdicts or scores prior to official publication.</li>
              <li>Request alterations to negative latency or cost findings.</li>
              <li>Sponsor editorial articles or software teardowns.</li>
            </ul>
          </div>
        </div>

        <div class="mt-space-sm p-space-sm bg-surface-container-low rounded-lg flex flex-wrap items-center justify-between gap-space-sm font-label-data text-label-data text-on-surface border border-outline-variant/30">
          <div class="flex items-center gap-space-xs">
            <span class="material-symbols-outlined text-secondary text-[20px]">gavel</span>
            <span>Binding FTC Rule 16 CFR Part 255 Conformity Audit: Passed</span>
          </div>
          <a class="text-secondary hover:underline flex items-center gap-space-3xs" href="/blog">
            <span>Explore Audited Software</span>
            <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
