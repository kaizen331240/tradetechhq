---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Related posts (excluding current)
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.slug !== entry.slug)
  .slice(0, 3);

const isServiceTitan = entry.slug === 'servicetitan-2026-audit';
---

<BaseLayout title={`${entry.data.title} | TradeTechHQ Audit`} description={entry.data.summary}>
  <div class="flex flex-col w-full">
    <!-- Top Global Audit Status & Live Breadcrumbs -->
    <section class="w-full bg-surface-container-low/70 py-space-sm border-b border-outline-variant/30">
      <div class="max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop flex flex-wrap items-center justify-between gap-y-space-xs text-on-surface-variant">
        <nav aria-label="Breadcrumb" class="flex items-center gap-space-2xs font-label-data text-label-data">
          <a class="text-on-surface-variant hover:text-on-surface transition-colors" href="/">Home</a>
          <span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
          <a class="text-on-surface-variant hover:text-on-surface transition-colors" href="/#matrix-section">{entry.data.category}</a>
          <span class="material-symbols-outlined text-[14px] text-outline">chevron_right</span>
          <span class="text-on-surface font-semibold truncate max-w-[220px] sm:max-w-none">{entry.data.title}</span>
        </nav>

        <div class="flex flex-wrap items-center gap-space-xs font-label-caps text-label-caps">
          <span class="inline-flex items-center gap-space-2xs px-space-xs py-space-3xs rounded-full bg-surface-container-lowest shadow-sm text-on-surface border border-outline-variant/30">
            <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
            Lab Test Active: Build v2026.1b4
          </span>
          <span class="hidden md:inline-flex items-center gap-space-2xs px-space-xs py-space-3xs rounded-full bg-surface-container-high/60 text-on-surface-variant">
            <span class="material-symbols-outlined text-[13px] text-secondary">memory</span>
            45-Commercial Truck Fleet Sandbox Synced
          </span>
        </div>
      </div>
    </section>

    <!-- Editorial Hero Section -->
    <article class="max-w-max-content-width mx-auto px-gutter-mobile lg:px-gutter-desktop pt-space-xl pb-space-3xl w-full">
      <header class="flex flex-col max-w-[1020px] mx-auto text-left gap-space-md">
        <div class="flex flex-wrap items-center gap-space-xs">
          <span class="px-space-xs py-space-3xs rounded-full bg-primary text-on-primary font-label-caps text-label-caps tracking-wider uppercase">
            Investigative Software Lab Audit
          </span>
          <span class="px-space-xs py-space-3xs rounded-full bg-surface-container-high text-on-surface-variant font-label-caps text-label-caps">
            {entry.data.category}
          </span>
          <span class="inline-flex items-center gap-space-3xs text-secondary font-label-caps text-label-caps">
            <span class="material-symbols-outlined text-[14px]">verified</span>
            FTC Compliant • Independent Lab Audit
          </span>
        </div>

        <h1 class="font-display-hero text-display-hero-mobile lg:text-display-hero text-on-surface tracking-tight leading-[1.08] mt-space-2xs font-normal">
          {entry.data.title}
        </h1>

        <p class="font-body-lead text-body-lead text-on-surface-variant leading-relaxed font-normal">
          {entry.data.summary}
        </p>

        <!-- Byline Card -->
        <div class="flex flex-wrap items-center justify-between gap-space-md pt-space-sm mt-space-xs border-b border-outline-variant/30 pb-space-lg">
          <div class="flex items-center gap-space-sm">
            <div class="w-12 h-12 rounded-full bg-surface-container-high flex items-center justify-center font-label-data font-semibold text-on-surface overflow-hidden shadow-sm border border-outline-variant/30">
              <span class="material-symbols-outlined text-[26px] text-secondary">engineering</span>
            </div>
            <div class="flex flex-col">
              <div class="flex items-center gap-space-2xs">
                <span class="font-headline-sm text-headline-sm text-on-surface">{entry.data.author}</span>
                <span class="material-symbols-outlined text-[16px] text-secondary" title="Certified Review Architect">verified</span>
              </div>
              <span class="font-caption text-caption text-on-surface-variant">{entry.data.authorRole}</span>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-space-sm font-label-data text-label-data text-on-surface-variant">
            <span class="inline-flex items-center gap-space-3xs">
              <span class="material-symbols-outlined text-[16px]">calendar_today</span>
              {entry.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' })}
            </span>
            <span class="text-outline-variant">•</span>
            <span class="inline-flex items-center gap-space-3xs">
              <span class="material-symbols-outlined text-[16px]">schedule</span>
              {entry.data.readTime}
            </span>
            <span class="text-outline-variant">•</span>
            <span class="inline-flex items-center gap-space-3xs px-space-xs py-space-3xs rounded-full bg-secondary/10 text-secondary font-label-caps text-label-caps">
              <span class="material-symbols-outlined text-[14px]">shield</span>
              FTC Audit Passed • Blind Testing Certified
            </span>
          </div>
        </div>
      </header>

      <!-- Top Executive Summary & Lab Verdict Box (Apple Minimalist Restraint) -->
      <section class="max-w-[1020px] mx-auto mt-space-2xl bg-surface-container-lowest rounded-xl shadow-xl shadow-surface-tint/5 p-space-md lg:p-space-xl border border-outline-variant/30">
        <div class="flex flex-col lg:flex-row gap-space-xl items-stretch">
          <!-- Verdict Score Column -->
          <div class="lg:w-1/3 flex flex-col justify-between bg-surface-container-low/60 rounded-lg p-space-lg border border-outline-variant/30">
            <div class="flex flex-col gap-space-2xs">
              <div class="flex items-center justify-between">
                <span class="font-label-caps text-label-caps uppercase tracking-wider text-secondary font-semibold">LAB BENCHMARK SCORE</span>
                <span class="material-symbols-outlined text-secondary text-[20px]">award_star</span>
              </div>
              <div class="flex items-baseline gap-space-2xs mt-space-sm">
                <span class="font-display-hero text-display-hero text-on-surface font-semibold tracking-tight">{entry.data.score.toFixed(1)}</span>
                <span class="font-headline-md text-headline-md text-on-surface-variant">/ 10</span>
              </div>
              <div class="flex items-center gap-space-3xs text-secondary-container mt-space-3xs">
                <span class="text-amber-500 text-[18px]">★</span>
                <span class="text-amber-500 text-[18px]">★</span>
                <span class="text-amber-500 text-[18px]">★</span>
                <span class="text-amber-500 text-[18px]">★</span>
                <span class="text-amber-500 text-[18px]">{entry.data.score >= 9.5 ? '★' : '★'}</span>
                <span class="font-label-data text-label-data text-on-surface font-medium ml-space-xs">Top 1% Class</span>
              </div>
              <p class="font-body-sm text-body-sm text-on-surface-variant mt-space-xs">
                Verified Lab Verdict: <strong class="text-on-surface font-semibold">{entry.data.badge || 'Exceptional Tier'}</strong>. Uncontested benchmark leader for high-velocity dispatching and multi-branch commercial field workflows.
              </p>
            </div>

            <div class="pt-space-md mt-space-md border-t border-outline-variant/30 flex flex-col gap-space-xs">
              <!-- CTA 1: Visit Vendor Site -->
              <a class="w-full flex items-center justify-center gap-space-2xs py-space-xs px-space-md rounded-lg bg-primary text-on-primary font-label-data text-label-data hover:bg-primary/90 transition-all shadow-md hover:shadow-lg" href={entry.data.vendorUrl} rel="noopener noreferrer" target="_blank">
                <span>Visit Vendor Official Site</span>
                <span class="material-symbols-outlined text-[16px]">open_in_new</span>
              </a>

              <!-- CTA 2: Export CSV -->
              <button class="w-full flex items-center justify-center gap-space-2xs py-space-xs px-space-md rounded-lg bg-surface-container hover:bg-surface-container-high text-on-surface font-label-data text-label-data transition-colors border border-outline-variant/30" id="exportCsvBtn" type="button">
                <span class="material-symbols-outlined text-[16px]">download</span>
                <span>Export Lab Telemetry Data (CSV)</span>
              </button>
            </div>
          </div>

          <!-- Metric Specs & Analysis Column -->
          <div class="lg:w-2/3 flex flex-col justify-between gap-space-lg">
            <!-- Quick Spec Matrix -->
            <div>
              <span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider block mb-space-xs font-semibold">Deployment Telemetry Profile</span>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-space-xs bg-surface-container/40 p-space-sm rounded-lg border border-outline-variant/20">
                <div class="flex flex-col">
                  <span class="font-caption text-caption text-on-surface-variant">Sweet-Spot Fleet</span>
                  <span class="font-headline-sm text-headline-sm text-on-surface mt-space-3xs font-semibold">
                    {entry.data.specs?.sweetSpotFleet || entry.data.recommendedFor || '15 – 100+'}
                  </span>
                  <span class="font-caption text-[11px] text-outline">Commercial Fleets</span>
                </div>
                <div class="flex flex-col">
                  <span class="font-caption text-caption text-on-surface-variant">Implementation</span>
                  <span class="font-headline-sm text-headline-sm text-on-surface mt-space-3xs font-semibold">
                    {entry.data.specs?.implementation || '4 – 12 Wks'}
                  </span>
                  <span class="font-caption text-[11px] text-outline">Onboarding Runway</span>
                </div>
                <div class="flex flex-col">
                  <span class="font-caption text-caption text-on-surface-variant">ERP Sync Pipeline</span>
                  <span class="font-headline-sm text-headline-sm text-on-surface mt-space-3xs font-semibold">
                    {entry.data.specs?.erpSync?.split(' ')[0] || '99.8%'}
                  </span>
                  <span class="font-caption text-[11px] text-outline">Intacct • NetSuite • QBO</span>
                </div>
                <div class="flex flex-col">
                  <span class="font-caption text-caption text-on-surface-variant">Base Pricing</span>
                  <span class="font-headline-sm text-headline-sm text-on-surface mt-space-3xs font-semibold">
                    {entry.data.specs?.basePricing?.split('/')[0] || entry.data.pricing || '$245 – $390'}
                  </span>
                  <span class="font-caption text-[11px] text-outline">Billed Annually</span>
                </div>
              </div>
            </div>

            <!-- Pros and Cons Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
              <div class="bg-surface-container-low/40 p-space-sm rounded-lg flex flex-col gap-space-xs border border-outline-variant/20">
                <div class="flex items-center gap-space-2xs text-secondary font-label-caps text-label-caps font-semibold">
                  <span class="material-symbols-outlined text-[16px]">check_circle</span>
                  <span>ENTERPRISE ADVANTAGES</span>
                </div>
                <ul class="space-y-space-xs font-body-sm text-body-sm text-on-surface">
                  {entry.data.pros.map((pro) => (
                    <li class="flex items-start gap-space-2xs">
                      <span class="w-1.5 h-1.5 rounded-full bg-secondary mt-2 flex-shrink-0"></span>
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="bg-surface-container-low/40 p-space-sm rounded-lg flex flex-col gap-space-xs border border-outline-variant/20">
                <div class="flex items-center gap-space-2xs text-error font-label-caps text-label-caps font-semibold">
                  <span class="material-symbols-outlined text-[16px]">error</span>
                  <span>IMPLEMENTATION FRICTION</span>
                </div>
                <ul class="space-y-space-xs font-body-sm text-body-sm text-on-surface">
                  {entry.data.cons.map((con) => (
                    <li class="flex items-start gap-space-2xs">
                      <span class="w-1.5 h-1.5 rounded-full bg-error mt-2 flex-shrink-0"></span>
                      <span>{con}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Main Dual-Column Body Area -->
      <div class="max-w-[1020px] mx-auto mt-space-3xl grid grid-cols-1 lg:grid-cols-12 gap-space-xl">
        <!-- Left Sticky Sidebar Index & Lab Metadata -->
        <aside class="lg:col-span-4 flex flex-col gap-space-lg">
          <div class="sticky top-28 bg-surface-container-lowest p-space-md rounded-xl shadow-sm border border-outline-variant/30 flex flex-col gap-space-md">
            <div class="flex items-center justify-between border-b border-outline-variant/30 pb-space-xs">
              <span class="font-label-caps text-label-caps text-on-surface font-semibold tracking-wider uppercase">Audit Sections</span>
              <span class="font-caption text-caption text-secondary font-medium">4 Chapters</span>
            </div>

            <nav class="flex flex-col gap-space-xs font-label-data text-label-data text-on-surface-variant">
              <a class="flex items-center justify-between p-space-xs rounded-lg hover:bg-surface-container-low hover:text-on-surface transition-colors group" href="#telemetry">
                <span class="group-hover:translate-x-0.5 transition-transform">1. Predictive Telemetry &amp; Routing</span>
                <span class="material-symbols-outlined text-[16px] text-outline">arrow_forward</span>
              </a>
              <a class="flex items-center justify-between p-space-xs rounded-lg hover:bg-surface-container-low hover:text-on-surface transition-colors group" href="#erp-sync">
                <span class="group-hover:translate-x-0.5 transition-transform">2. Accounting &amp; ERP Latency</span>
                <span class="material-symbols-outlined text-[16px] text-outline">arrow_forward</span>
              </a>
              <a class="flex items-center justify-between p-space-xs rounded-lg hover:bg-surface-container-low hover:text-on-surface transition-colors group" href="#implementation-cost">
                <span class="group-hover:translate-x-0.5 transition-transform">3. Implementation Toll &amp; ROI</span>
                <span class="material-symbols-outlined text-[16px] text-outline">arrow_forward</span>
              </a>
              <a class="flex items-center justify-between p-space-xs rounded-lg hover:bg-surface-container-low hover:text-on-surface transition-colors group" href="#mobile-cache">
                <span class="group-hover:translate-x-0.5 transition-transform">4. Mobile Offline Protocol</span>
                <span class="material-symbols-outlined text-[16px] text-outline">arrow_forward</span>
              </a>
              <a class="flex items-center justify-between p-space-xs rounded-lg bg-surface-container-low text-on-surface font-semibold" href="#final-verdict">
                <span>Final Procurement Verdict</span>
                <span class="material-symbols-outlined text-[16px] text-secondary">verified</span>
              </a>
            </nav>

            <!-- Simulated Lab Fleet Specs Box -->
            <div class="mt-space-xs p-space-sm bg-surface-container-low rounded-lg flex flex-col gap-space-2xs border border-outline-variant/30">
              <span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-wider font-semibold">Lab Environment Spec</span>
              <div class="font-caption text-caption text-on-surface space-y-space-3xs mt-space-3xs">
                <div class="flex justify-between">
                  <span class="text-on-surface-variant">Simulated Fleet:</span>
                  <span class="font-semibold">45 Vehicles (Tier-3)</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-on-surface-variant">Total Work Orders:</span>
                  <span class="font-semibold">1,280 Tickets</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-on-surface-variant">ERP Connector:</span>
                  <span class="font-semibold">REST v4 + Webhooks</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-on-surface-variant">Testing Horizon:</span>
                  <span class="font-semibold">30 Consecutive Days</span>
                </div>
              </div>
            </div>

            <!-- Quick Interactive Estimator Widget -->
            <div class="p-space-sm bg-primary-container text-on-primary rounded-lg flex flex-col gap-space-xs shadow-md">
              <span class="font-label-caps text-label-caps text-on-primary-container tracking-wider uppercase font-semibold">Interactive ROI Estimator</span>
              <p class="font-caption text-caption text-inverse-on-surface/80">
                Calculate projected monthly payback on routing fuel reduction &amp; ticket size uplift.
              </p>
              <div class="flex flex-col gap-space-3xs mt-space-2xs">
                <label class="font-caption text-caption text-on-primary-container flex justify-between" for="truckSlider">
                  <span>Fleet Scale:</span>
                  <span class="font-semibold text-on-primary" id="truckCountDisplay">35 Trucks</span>
                </label>
                <input class="w-full accent-secondary cursor-pointer" id="truckSlider" max="150" min="10" step="5" type="range" value="35" />
              </div>
              <div class="flex items-center justify-between pt-space-xs border-t border-on-primary-container/20">
                <span class="font-caption text-caption text-on-primary-container">Est. Net Monthly Lift:</span>
                <span class="font-label-data text-label-data font-semibold text-secondary-fixed" id="liftDisplay">+$14,700/mo</span>
              </div>
            </div>
          </div>
        </aside>

        <!-- Right Main Editorial Content Column -->
        <main class="lg:col-span-8 flex flex-col gap-space-3xl">
          <!-- Chapter 1: Dispatch & Predictive GPS Telemetry -->
          <section class="flex flex-col gap-space-md scroll-mt-28" id="telemetry">
            <div class="flex items-center gap-space-2xs">
              <span class="font-label-caps text-label-caps px-space-xs py-space-3xs rounded bg-surface-container-high text-on-surface font-semibold">CHAPTER 01</span>
              <span class="font-label-caps text-label-caps text-on-surface-variant font-semibold">Core Dispatch Architecture</span>
            </div>
            <h2 class="font-headline-xl text-headline-xl text-on-surface tracking-tight font-normal">
              Dispatch &amp; Predictive GPS Telemetry: Where Milliseconds Save Gallons
            </h2>
            <p class="font-body-md text-body-md text-on-surface leading-relaxed">
              ServiceTitan's dispatcher console has long set the benchmark for high-density trade dispatching. For the 2026 iteration, our primary lab objective was to verify whether the newly marketed <em>Dynamic Geofence Re-allocation</em> can handle acute intraday schedule disruption without operator hallucination or latency degradation.
            </p>

            <!-- Rich Interactive Latency Chart Visual -->
            <div class="my-space-md p-space-md bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 flex flex-col gap-space-md">
              <div class="flex flex-wrap items-center justify-between gap-space-2xs">
                <div>
                  <h3 class="font-headline-sm text-headline-sm text-on-surface">Algorithmic Re-Route Latency vs. Fleet Scale</h3>
                  <span class="font-caption text-caption text-on-surface-variant">Time in milliseconds to recalculate optimal path upon urgent technician reassignment</span>
                </div>
                <span class="font-label-caps text-label-caps px-space-xs py-space-3xs rounded bg-surface-container text-secondary font-semibold">
                  LAB STRESS TEST
                </span>
              </div>

              <!-- Bar Chart Component -->
              <div class="space-y-space-sm pt-space-2xs">
                <div class="flex flex-col gap-space-3xs">
                  <div class="flex justify-between font-label-data text-label-data">
                    <span class="text-on-surface">10-Truck Fleet Sandbox</span>
                    <span class="font-semibold text-on-surface">320 ms • Instantaneous</span>
                  </div>
                  <div class="w-full bg-surface-container-high rounded-full h-3 overflow-hidden">
                    <div class="bg-secondary h-full rounded-full transition-all duration-700" style="width: 28%;"></div>
                  </div>
                </div>

                <div class="flex flex-col gap-space-3xs">
                  <div class="flex justify-between font-label-data text-label-data">
                    <span class="text-on-surface">25-Truck Fleet Sandbox</span>
                    <span class="font-semibold text-on-surface">480 ms • Sub-second</span>
                  </div>
                  <div class="w-full bg-surface-container-high rounded-full h-3 overflow-hidden">
                    <div class="bg-secondary h-full rounded-full transition-all duration-700" style="width: 42%;"></div>
                  </div>
                </div>

                <div class="flex flex-col gap-space-3xs">
                  <div class="flex justify-between font-label-data text-label-data">
                    <span class="text-on-surface">45-Truck Fleet Sandbox (Lab Standard)</span>
                    <span class="font-semibold text-on-surface">710 ms • Superior Parity</span>
                  </div>
                  <div class="w-full bg-surface-container-high rounded-full h-3 overflow-hidden">
                    <div class="bg-secondary h-full rounded-full transition-all duration-700" style="width: 62%;"></div>
                  </div>
                </div>

                <div class="flex flex-col gap-space-3xs">
                  <div class="flex justify-between font-label-data text-label-data">
                    <span class="text-on-surface">100-Truck Peak Simulated Concurrency</span>
                    <span class="font-semibold text-on-surface">1,140 ms • Minor Buffer</span>
                  </div>
                  <div class="w-full bg-surface-container-high rounded-full h-3 overflow-hidden">
                    <div class="bg-outline h-full rounded-full transition-all duration-700" style="width: 95%;"></div>
                  </div>
                </div>
              </div>

              <div class="pt-space-xs border-t border-outline-variant/30 flex items-center gap-space-2xs text-on-surface-variant font-caption text-caption">
                <span class="material-symbols-outlined text-[16px] text-secondary">info</span>
                <span>Lab Finding: Re-route calculations remained deterministic under simulated network packet drop rates up to 15%.</span>
              </div>
            </div>

            <p class="font-body-md text-body-md text-on-surface leading-relaxed">
              During peak midday dispatch shifts, the visual board dynamically recalibrates drive times using historical transit matrices. Rather than forcing manual drag-and-drop actions, the dispatch assistant flags potential appointment overlaps 18 to 22 minutes prior to breach, allowing customer service representatives to proactively alert homeowners via automated SMS.
            </p>

            <!-- Lab Visual Inspection Image -->
            <div class="relative rounded-xl overflow-hidden shadow-md my-space-xs border border-outline-variant/30">
              <img class="w-full h-80 object-cover" alt="Enterprise trade operations control room displaying dispatch maps and telematics" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCpy9zlH8jrL-7Kl-kKWKrSFc1kDwGHNfsbFlpsvQjTvG7hRZKyYyIQQVNAB6QkUnVWO6ytk0NDcgFPw0YHoEjedpe1fU0VjIiSs8l6B98DBjtfAih0kOJHkV4gtFmOjwnXcuLK9UUO5WIFEVkKK_QZAcmCdE7w_Lb38j42XgDXfulpp-qJmeCkI2Ou6ssj5Yt25atrcBfPbGKSTRN49vnoF0j-RU-P4HPgmreIAL8n0L-Tg_NEinxL" />
              <div class="p-space-sm bg-surface-container-low text-on-surface-variant font-caption text-caption border-t border-outline-variant/30">
                <strong>Figure 1.1:</strong> Live field routing simulation matrix across our 45-vehicle testing topology. The algorithm preserved fuel-efficient clustering even through randomized route cancellation injects.
              </div>
            </div>
          </section>

          <!-- Chapter 2: QuickBooks & ERP Bidirectional Sync -->
          <section class="flex flex-col gap-space-md scroll-mt-28" id="erp-sync">
            <div class="flex items-center gap-space-2xs">
              <span class="font-label-caps text-label-caps px-space-xs py-space-3xs rounded bg-surface-container-high text-on-surface font-semibold">CHAPTER 02</span>
              <span class="font-label-caps text-label-caps text-on-surface-variant font-semibold">General Ledger Integrations</span>
            </div>
            <h2 class="font-headline-xl text-headline-xl text-on-surface tracking-tight font-normal">
              Bidirectional ERP Integrity: QuickBooks, Sage Intacct, and NetSuite
            </h2>
