  <!-- Inline Micro-Interaction Script for ROI Estimator & CSV Export -->
  <script is:inline>
    (function initAuditInteractive() {
      const truckSlider = document.getElementById('truckSlider');
      const truckDisplay = document.getElementById('truckCountDisplay');
      const liftDisplay = document.getElementById('liftDisplay');
      const exportBtn = document.getElementById('exportCsvBtn');

      if (truckSlider && truckDisplay && liftDisplay) {
        truckSlider.addEventListener('input', function(e) {
          const count = parseInt(e.target.value, 10);
          truckDisplay.textContent = count + ' Trucks';
          // Estimated monthly savings based on $420 average lift per tech per month
          const totalLift = count * 420;
          liftDisplay.textContent = '+$' + totalLift.toLocaleString() + '/mo';
        });
      }

      if (exportBtn) {
        exportBtn.addEventListener('click', function() {
          const csvContent = "data:text/csv;charset=utf-8," + 
            "Metric,Value,BenchmarkStatus\n" +
            "Overall Score,9.6,Top 1% Exceptional\n" +
            "Recommended Fleet Size,20-500+ Trucks,Enterprise\n" +
            "Algorithmic Re-Route Latency (45 trucks),710ms,Pass\n" +
            "Sage Intacct REST API Sync Latency,1.2s,Pass\n" +
            "NetSuite Parity,99.8%,Pass\n" +
            "Faraday Cage Offline Recovery,100%,Pass\n" +
            "Base License Tier,$245-$390/tech/mo,Standard Enterprise";
          const encodedUri = encodeURI(csvContent);
          const link = document.createElement("a");
          link.setAttribute("href", encodedUri);
          link.setAttribute("download", "TradeTechHQ_ServiceTitan_2026_Audit_Telemetry.csv");
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        });
      }
    })();
  </script>
